# CertifLoop - modele de .env pour la production.
# Copier en .env sur le serveur, remplir les valeurs, puis : php artisan key:generate
# Ne jamais commiter le vrai .env.

APP_NAME=CertifLoop
APP_ENV=production
APP_KEY=
# false obligatoire : true affiche le code et la config dans les pages d'erreur.
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://certifloop.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL ou PostgreSQL recommande des qu'il y a plusieurs utilisateurs simultanes.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=certifloop
DB_USERNAME=certifloop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies de session envoyes uniquement en HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Necessite un worker permanent : php artisan queue:work --tries=3 (supervisor / systemd).
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# E-mails reels : reinitialisation du mot de passe, verification d'adresse, rappels.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Adresse affichee aussi comme contact sur la page /legal.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Premier admin, cree par `php artisan db:seed --force` (12 caracteres minimum).
# Aucun compte de demo n'est cree en production. Vider ADMIN_PASSWORD apres le premier seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sentry / GlitchTip (optionnel mais conseille).
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# Scheduler (rappels, digest hebdo) : ajouter au crontab du serveur
# * * * * * cd /chemin/vers/certifloop && php artisan schedule:run >> /dev/null 2>&1
