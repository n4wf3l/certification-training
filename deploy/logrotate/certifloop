# Journal d'erreurs nginx de CertifLoop : il peut contenir des IP clientes
# ("client: ..."), donc on n'en garde jamais plus de 24 h.
/var/log/nginx/certifloop.error.log {
    daily
    rotate 0
    missingok
    notifempty
    create 0640 www-data adm
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
